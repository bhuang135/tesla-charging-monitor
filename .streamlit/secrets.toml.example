# =============================================================
# Tesla 充電健康監測 — Secrets 範本
# =============================================================
# 將此檔案複製為 `.streamlit/secrets.toml` 並填入您的金鑰。
# 完整 Google Sheets 設定步驟請見 SETUP_GOOGLE_SHEETS.md
# =============================================================

# Google Gemini Vision API Key（OCR 擷取里程與電量用）
# 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza..."


# Google Sheets 持久化儲存（在 Streamlit Cloud 部署時必填）
# 詳細設定步驟：SETUP_GOOGLE_SHEETS.md
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "..."
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# """
# client_email = "xxx@your-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"
#
# [gsheets]
# spreadsheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"
